generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CANDIDATE
  RECRUITER
  ADMIN
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  INTERVIEWED
  ACCEPTED
  REJECTED
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(CANDIDATE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Profile relationship for candidates
  profile      Profile?
  // Applications submitted by candidates
  applications Application[]

  // Company management for recruiters
  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])

  // Job offers created by recruiters
  jobOffers JobOffer[]
}

model Profile {
  id        Int     @id @default(autoincrement())
  bio       String?
  headline  String?
  resumeUrl String?
  userId    Int     @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Company {
  id          Int        @id @default(autoincrement())
  name        String
  description String?
  website     String?
  location    String?
  createdAt   DateTime   @default(now())
  
  recruiters  User[]
  jobOffers   JobOffer[]
}

model JobOffer {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  location    String?
  salary      String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  authorId    Int
  author      User     @relation(fields: [authorId], references: [id])

  applications Application[]
}

model Application {
  id          Int               @id @default(autoincrement())
  status      ApplicationStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  
  candidateId Int
  candidate   User              @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  jobOfferId  Int
  jobOffer    JobOffer          @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)

  @@unique([candidateId, jobOfferId]) // Prevents candidate from applying to the same job twice
}